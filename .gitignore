# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# ...except the template, which is the only record of which variables the app
# needs. The blanket rule above was swallowing it, so a fresh clone had nothing
# documenting the Supabase, Resend, GA4 or Termageddon configuration. It holds
# no secrets: every value in it is blank or already public.
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
