# Copy to .env.local and fill in.
#
# These values come from the Supabase dashboard: Project Settings > API.
# The publishable key is safe in the browser and can only read public content.
# Lead submissions go through a validated server action and the service-only
# submit_lead database function; visitors cannot insert into the leads table.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Never add NEXT_PUBLIC_ to either value and never commit them.
SUPABASE_SERVICE_ROLE_KEY=
# Generate a random value of at least 32 characters, for example:
# openssl rand -base64 48
LEAD_SECURITY_SECRET=

NEXT_PUBLIC_SITE_URL=https://jordanmarketingconsultants.com

# Resources is built but stays private until the content hub launches. This
# gate covers direct article URLs, RSS, related posts, and the sitemap.
RESOURCES_PUBLISHED=false

# Lead notification email. Without these values the site still stores inquiries
# in the dashboard, marks email as not configured, and offers a Retry button.
#
# LEAD_NOTIFICATION_FROM must use a sender/domain verified in Resend.
RESEND_API_KEY=
LEAD_NOTIFICATION_EMAIL=wendell@jordanmarketingconsultants.com
LEAD_NOTIFICATION_FROM="JMC Website <notifications@jordanmarketingconsultants.com>"
# The reference site's MAIL_TO and MAIL_FROM names are accepted as aliases, but
# the LEAD_NOTIFICATION_* names above are preferred for this project.

# GA4. Optional: without it the site loads no tag, sets no cookie, and shows no
# cookie banner — there is nothing to consent to until this is filled in.
#
# Must be the Measurement ID (G-XXXXXXXXXX) from Admin > Data streams > Web, not
# the Tag ID (GT-) or a Tag Manager container (GTM-). A wrong-shaped value is
# ignored rather than loading a tag that reports nowhere.
#
# Public by design: it ships in the tag URL on every GA4 site on the web.
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Termageddon policy keys. Each one turns its route from a 404 into a live page
# and adds its link to the footer and the sitemap. Until a key is set the policy
# is deliberately not published — see lib/legal.ts for why.
TERMAGEDDON_PRIVACY_KEY=
TERMAGEDDON_TERMS_KEY=
TERMAGEDDON_COOKIES_KEY=
